# Isolated runtime verification. No host networking, mounts, or published ports.
FROM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 python3 samba wsdd && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
COPY examples ./examples
COPY LICENSE NOTICE THIRD_PARTY_LICENSES README.md Makefile ./
COPY scripts/test-install.py scripts/release.sh ./scripts/
COPY scripts/test-ndp-linux.py /usr/local/bin/test-ndp-linux.py
COPY scripts/test-neighbor-interfaces.py /usr/local/bin/test-neighbor-interfaces.py
COPY scripts/test-full-ports.py /usr/local/bin/test-full-ports.py
COPY scripts/test-event-stream.py /usr/local/bin/test-event-stream.py
COPY scripts/test-doctor.py /usr/local/bin/test-doctor.py
COPY scripts/test-snapshot-cli.py /usr/local/bin/test-snapshot-cli.py
COPY scripts/test-banner-fingerprints.py /usr/local/bin/test-banner-fingerprints.py
COPY scripts/test-mail-fingerprints.py /usr/local/bin/test-mail-fingerprints.py
COPY scripts/test-greeting-fingerprints.py /usr/local/bin/test-greeting-fingerprints.py
COPY scripts/test-ethernet-darwin.py scripts/test-ethernet-fixture.py /usr/local/bin/
COPY scripts/test-watch-pty.py /usr/local/bin/test-watch-pty.py
COPY scripts/test-netbios-samba.sh /usr/local/bin/test-netbios-samba.sh
COPY scripts/test-wsdd.py /usr/local/bin/test-wsdd.py
COPY scripts/test-linux-container.sh /usr/local/bin/lantern-test
CMD ["sh", "/usr/local/bin/lantern-test"]
